<mxfile host="app.diagrams.net"><diagram id="CM1" name="CM1 - Luồng chính và luồng 2a, 4a (SD1)"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="490" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="CM1-O-KH" value=":Khách" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="40" height="60" as="geometry" /></mxCell><mxCell id="CM1-O-FM" value="&lt;u&gt;:ViewBookingHistoryForm&lt;/u&gt;&lt;br&gt;«boundary»" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="240" y="190" width="160" height="60" as="geometry" /></mxCell><mxCell id="CM1-O-CT" value="&lt;u&gt;:ViewBookingHistoryController&lt;/u&gt;&lt;br&gt;«control»" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="540" y="190" width="160" height="60" as="geometry" /></mxCell><mxCell id="CM1-O-CU" value="&lt;u&gt;:Customer&lt;/u&gt;&lt;br&gt;«entity»" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="840" y="90" width="160" height="60" as="geometry" /></mxCell><mxCell id="CM1-O-BK" value="&lt;u&gt;:Booking&lt;/u&gt;&lt;br&gt;«entity»" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="840" y="290" width="160" height="60" as="geometry" /></mxCell><mxCell id="CM1-O-TK" value="&lt;u&gt;:Ticket&lt;/u&gt;&lt;br&gt;«entity»" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="1140" y="290" width="160" height="60" as="geometry" /></mxCell><mxCell id="CM1-O-ST" value="&lt;u&gt;:Showtime&lt;/u&gt;&lt;br&gt;«entity»" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="1440" y="290" width="160" height="60" as="geometry" /></mxCell><mxCell id="CM1-L1" value="1: // requestBookingHistory (--&gt;)&lt;br&gt;2: // selectBooking (lần đặt cần x