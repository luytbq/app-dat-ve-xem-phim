ell id="CM1-L6" value="1.1.3.1.1.1: // provideShowtimeSchedule (--&gt;) [lặp: mỗi lần đặt của khách, từ lần đặt gần nhất trước]&lt;br&gt;2.1.3.1.1: // provideShowtimeSchedule (--&gt;) [lặp: mỗi vé của lần đặt]" style="endArrow=none;html=1;labelBackgroundColor=#ffffff;fontSize=10;align=center;" edge="1" parent="1" source="CM1-O-TK" target="CM1-O-ST"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="CM1-L7" value="2.1.3: // provideBookingHistoryDetail (--&gt;) [lần đặt đã chọn thuộc khách]" style="endArrow=none;html=1;labelBackgroundColor=#ffffff;fontSize=10;align=center;" edge="1" parent="1" source="CM1-O-CT" target="CM1-O-BK"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>