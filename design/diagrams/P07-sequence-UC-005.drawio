          <mxCell id="SD9-M-4a.1" value="4a.1: // handlePaymentReport (thất bại, mã giao dịch, mã tham chiếu lần giữ ghế, thời điểm nhận báo)" style="endArrow=block;endFill=1;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1060" y="240" as="sourcePoint" /><mxPoint x="420" y="240" as="targetPoint" /></mxGeometry></mxCell>
