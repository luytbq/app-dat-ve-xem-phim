          <mxCell id="CM2-L1" value="1.1.1a.1: // notifyRefusal (vé không phải vé mua trực tuyến của khách, BR-17) (&lt;--) [khách huỷ vé không phải vé mua trực tuyến của mình (BR-17)]&lt;br&gt;1.1.2a.1: // notifyRefusal (quá hạn huỷ vé, BR-18) (&lt;--) [thời điểm kiểm tra cách giờ bắt đầu chưa tới 2 tiếng, kể cả suất chiếu đã bắt đầu hoặc đã kết thúc (BR-18, BR-32)]&lt;br&gt;1.1.3a.1: // notifyRefusal (vé đã huỷ, không hoàn tiền thêm, BR-21) (&lt;--) [vé đã huỷ, kể cả vừa bị huỷ bởi yêu cầu huỷ khác xử lý ngay trước đó (BR-21)]&lt;br&gt;1.1.3b.1: // notifyRefusal (vé đã sử dụng không huỷ được, BR-30) (&lt;--) [vé chưa huỷ và đã sử dụng, kể cả vừa được soát ngay trước đó (BR-30)]" style="endArrow=none;html=1;labelBackgroundColor=#ffffff;fontSize=10;align=center;" edge="1" parent="1" source="CM2-O-BF" target="CM2-O-C"><mxGeometry relative="1" as="geometry" /></mxCell>
          <mxCell id="CM2-L2" value="1.1.7b.1: // after(BR-43) handleRefundNoResponse (--&gt;)&lt;br&gt;1.1.7b.2: // checkRefundRetriesLeft (BR-41) (--&gt;)&lt;br&gt;1.1.7b.3: // startWaitingForRefundResponse (BR-43) (--&gt;) [còn lượt thử lại (BR-41)]&lt;br&gt;1.1.7c.1: // logRefundFailure (mã vé, mã giao dịch, số tiền hoàn, BR-41) (--&gt;) [còn lượt thử lại (BR-41)]&lt;br&gt;1.1.8a.1: // stopWaitingForRefundResponse (--&gt;)&lt;br&gt;1.1.8a.2: // checkRefundRetriesLeft (BR-41) (--&gt;)&lt;br&gt;1.1.8a.3: // startWaitingForRefundResponse (BR-43) (--&gt;) [còn lượt thử lại (BR-41)]&lt;br&gt;1.1.8b.1: // logRefundFailure (mã vé, mã giao dịch, số tiền hoàn, BR-41) (--&gt;) [còn lượt thử lại (BR-41)]" style="endArrow=none;html=1;labelBackgroundColor=#ffffff;fontSize=10;align=center;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="CM2-O-C" target="CM2-O-C"><mxGeometry relative="1" as="geometry" /></mxCell>
