          <mxCell id="CM3-L2" value="1.1.4a.2: // showCashRefund (số tiền mặt cần hoàn, hình thức hoàn tiền: tiền mặt) (&lt;--)&lt;br&gt;2(5a).1: // confirmCashRefund (--&gt;)&lt;br&gt;2(5a).1.5: // showCancellationResult (vé đã huỷ, giá vé, số tiền hoàn, hình thức hoàn tiền, tình trạng hoàn tiền) (&lt;--)&lt;br&gt;1a.1: // findBookingTickets (mã đặt vé) (--&gt;)&lt;br&gt;1a.1.1: // notifyRefusal (mã đặt vé không tồn tại) (&lt;--) [mã đặt vé không trùng mã của lần đặt nào (1a1a)]&lt;br&gt;1a.1.3: // showBookingTickets (các vé của lần đặt: vị trí ghế, giá vé, trạng thái vé) (&lt;--) [mã đặt vé không trùng mã của lần đặt nào (1a1a)]&lt;br&gt;1.1[ACT-02]: // requestCancellation (vé cần huỷ) (--&gt;)&lt;br&gt;1.1.1b.1: // notifyRefusal (vé mua trực tuyến, BR-17) (&lt;--) [tác nhân là nhân viên quầy và vé là vé mua trực tuyến (BR-17)]&lt;br&gt;1.1.1c.1: // notifyRefusal (vé quầy của cụm rạp khác, BR-17) (&lt;--) [vé mua tại quầy của cụm rạp khác cụm rạp của nhân viên quầy (BR-17)]" style="endArrow=none;html=1;labelBackgroundColor=#ffffff;fontSize=10;align=center;" edge="1" parent="1" source="CM3-O-CF" target="CM3-O-C"><mxGeometry relative="1" as="geometry" x="-0.2" /></mxCell>
