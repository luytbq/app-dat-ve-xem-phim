 sách phòng chiếu) (&lt;--)&lt;br&gt;2.1: // submitAuditorium (thông tin phòng chiếu, sơ đồ ghế; luồng 1a kèm mốc thay đổi lúc hiển thị) (--&gt;)&lt;br&gt;2.1.4: // notifyRefusal (điều kiện bị vi phạm của từng trường) (&lt;--) [thông tin phòng chiếu hoặc sơ đồ ghế không đạt điều kiện hợp lệ (4a)]&lt;br&gt;2.1.5: // notifyRefusal (sức chứa ngoài khoảng 50 đến 400 ghế, BR-144) (&lt;--) [sức chứa ngoài khoảng 50 đến 400 ghế, không thuộc 4a (4b)]&lt;br&gt;2.1.7: // notifyRefusal (tên phòng chiếu đã thuộc phòng khác trong cụm rạp, BR-145) (&lt;--) [tên phòng chiếu đã thuộc phòng khác trong cùng cụm rạp (4d)]&lt;br&gt;2.1.9: // showSavedAuditorium (phòng chiếu đã lưu cùng sức chứa) (&lt;--)&lt;br&gt;1a.1: // startAuditoriumEdit (--&gt;)&lt;br&gt;1a.1.3: // showAuditoriumList (danh sách phòng chiếu, mốc thay đổi lúc hiển thị) (&lt;--)&lt;br&gt;2a.1: // selectAuditorium (phòng chiếu đã chọn) (--&gt;)&lt;br&gt;2a.1.3: // showAuditoriumForEdit (thông tin hiện tại của phòng chiếu, từng ghế) (&lt;--)&lt;br&gt;2.1.7a: // notifyRefusal (phòng chiếu đã bị sửa, mở lại phòng chiếu từ đầu, BR-146) (&lt;--) [phòng chiếu đã bị yêu cầu khác sửa kể từ lúc hiển thị (5c)]&lt;br&gt;2.1.8a: // notifyRefusal (tên phòng chiếu đã thuộc phòng khác trong cụm rạp, BR-145) (&lt;--) [tên phòng chiếu đã thuộc phòng khác trong cùng cụm rạp (4d)]&lt;br&gt;2.1.9a: // notifyRefusal (phòng có suất chiếu đã mở bán chưa kết thúc, BR-87) (&lt;--) [sơ đồ ghế bị thay đổi và phòng có suất chiếu đã tới thời điểm mở bán mà chưa kết thúc (5a)]&lt;br&gt;2.1.10a: // notifyRefusal (suất chiếu chưa tới giờ bắt đầu sẽ thiếu giá, BR-73) (&lt;--) [đổi loại phòng hoặc loại ghế làm suất chiếu chưa tới giờ bắt đầu thiếu giá, không thuộc 5a (5b)]&lt;br&gt;2.1.13a: // showSavedAuditorium (phòng chiếu đã lưu cùng sức chứa) (&lt;--)&lt;br&gt;1b.1: // startAuditoriumRemoval (--&gt;)&lt;br&gt;1b.1.3: // showAuditoriumList (danh sách phòng chiếu) (&lt;--)&lt;br&gt;2b.1: // submitAuditoriumRemoval (phòng chiếu đã chọn) (--&gt;)&lt;br&gt;2b.1.3: // notifyRefusal (phòng chiếu đã từng có suất chiếu, kể cả suất chiếu đã xoá, BR-147) (&lt;--) [phòng chiếu đã từng có suất chiếu, kể cả suất chiếu đã xoá (1b3a)]&lt;br&gt;2b.1.4: // showRemovalSuccess (&lt;--)&lt;br&gt;1*a.1: // cancelRequest (--&gt;)" style="endArrow=none;html=1;labelBackgroundColor=#ffffff;fontSize=10;align=center;" edge="1" parent="1" source="CM1-O-PF" target="CM1-O-C"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="CM1-L3" value="1.1.1: // provideCinema (BR-135) (--&gt;)&lt;br&gt;1a.1.1: // provideCinema (BR-135) (--&gt;)&lt;br&gt;1b.1.1: // provideCinema (BR-135) (--&gt;)" style="endArrow=none;html=1;labelBackgroundColor=#ffffff;fontSize=10;align=center;" edge="1" parent="1" source="CM1-O-C" target="CM1-O-CM"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="CM1-L4" value="1.1.2: // provideAuditoriums (--&gt;)&lt;br&gt;2.1.6: // addAuditorium (phòng chiếu dự kiến, tên phòng chiếu) (--&gt;)&lt;br&gt;1a.1.2: // provideAuditoriums (--&gt;)&lt;br&gt;1b.1.2: // provideAuditoriums (--&gt;)&lt;br&gt;2b.1.2: // removeAuditorium (phòng chiếu đã chọn) (--&gt;)" style="endArrow=none;html=1;labelBackgroundColor=#ffffff;fontSize=10;align=center;" edge="1" parent="1" source="CM1-O-C" target="CM1-O-CI"><mxGeometry relative="1" as="geometry" x="-0.3" /></mxCell><mxCell id="CM1-L5" value="1.1.2.1: // provideAuditoriumInfo (--&gt;) [lặp: mỗi phòng chiếu của cụm rạp]&lt;br&gt;1a.1.2.1: // provideAuditoriumInfo (--&gt;) [lặp: mỗi phòng chiếu của cụm rạp]&lt;br&gt;1b.1.2.1: // provideAuditoriumInfo (--&gt;) [lặp: mỗi phòng chiếu của cụm rạp]" style="endArrow=none;html=1;labelBackgroundColor=#ffffff;fontSize=10;align=center;" edge="1" parent="1" source="CM1-O-CI" target="CM1-O-AU"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="CM1-L6" value="2.1.1: «create» // createAuditorium (thông tin phòng chiếu đã nhập) (--&gt;)&lt;br&gt;2.1.2: // checkAuditoriumInfoValid (--&gt;)&lt;br&gt;2.1.3: // checkCapacityInRange (B