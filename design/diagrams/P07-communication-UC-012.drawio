<mxfile host="app.diagrams.net"><diagram id="CM1" name="Mọi luồng"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="6000" pageHeight="2400" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="CM1-O-A4" value=":Quản lý cụm rạp" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;" vertex="1" parent="1"><mxGeometry x="25" y="100" width="30" height="60" as="geometry" /></mxCell><mxCell id="CM1-O-PF" value="&lt;u&gt;:ManageAuditoriumsForm&lt;/u&gt;&lt;br&gt;«boundary»" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="990" y="100" width="160" height="60" as="geometry" /></mxCell><mxCell id="CM1-O-C" value="&lt;u&gt;:ManageAuditoriumsController&lt;/u&gt;&lt;br&gt;«control»" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="2090" y="100" width="160" height="60" as="geometry" /></mxCell><mxCell id="CM1-O-CM" value="&lt;u&gt;:CinemaManager&lt;/u&gt;&lt;br&gt;«entity»" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="3190" y="100" width="160" height="60" as="geometry" /></mxCell><mxCell id="CM1-O-CI" value="&lt;u&gt;:Cinema&lt;/u&gt;&lt;br&gt;«entity»" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="4290" y="100" width="160" height="60" as="geometry" /></mxCell><mxCell id="CM1-O-AU" value="&lt;u&gt;:Auditorium&lt;/u&gt;&lt;br&gt;«entity»" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="5390" y="100" width="160" height="60" as="geometry" /></mxCell><mxCell id="CM1-O-AD" value="&lt;u&gt;phòngMới:Auditorium&lt;/u&gt;&lt;br&gt;«entity»" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="2090" y="800" width="160" height="60" as="geometry" /></mxCell><mxCell id="CM1-O-AS" value="&lt;u&gt;phòngChọn:Auditorium&lt;/u&gt;&lt;br&gt;«entity»" style="rounded=0;wh