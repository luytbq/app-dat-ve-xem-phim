ry" /></mxCell><mxCell id="CM1-L17" value="2.1.6a.5.1: // checkCoversShowtime (loại phòng, loại ghế, giờ bắt đầu, định dạng, BR-69) (--&gt;)" style="endArrow=none;html=1;labelBackgroundColor=#ffffff;fontSize=10;align=center;" edge="1" parent="1" source="CM1-O-ST2" target="CM1-O-PL"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="CM1-L18" value="2.1.11a.1: // adoptSeatMap (sơ đồ ghế mới, BR-118) (--&gt;) [lặp: mỗi suất chiếu của phòng chưa tới thời điểm mở bán, khi sơ đồ ghế thay đổi]" style="endArrow=none;html=1;labelBackgroundColor=#ffffff;fontSize=10;align=center;" edge="1" parent="1" source="CM1-O-AS" target="CM1-O-ST3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="CM1-L19" value="1*a.1.1: // discardRequest (không đổi phòng chiếu) (--&gt;)" style="endArrow=none;html=1;labelBackgroundColor=#ffffff;fontSize=10;align=center;" edge="1" parent="1" source="CM1-O-C" target="CM1-O-C"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>
