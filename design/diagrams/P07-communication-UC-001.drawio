<mxfile host="app.diagrams.net"><diagram id="CM1" name="CM1 - Luồng chính và các luồng thay thế (SD1, SD2)"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="300" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="CM1-O-KH" value=":Khách" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="40" height="60" as="geometry" /></mxCell><mxCell id="CM1-O-FM" value="&lt;u&gt;:RegisterAccountForm&lt;/u&gt;&lt;br&gt;«boundary»" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="240" y="90" width="160" height="60" as="geometry" /></mxCell><mxCell id="CM1-O-CT" value="&lt;u&gt;:RegisterAccountController&lt;/u&gt;&lt;br&gt;«control»" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="540" y="90" width="160" height="60" as="geometry" /></mxCell><mxCell id="CM1-O-CU" value="&lt;u&gt;:Customer&lt;/u&gt;&lt;br&gt;«entity»" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="840" y="90" width="160" height="60" as="geometry" /></mxCell><mxCell id="CM1-L1" value="1: // requestRegistration (--&gt;)&lt;br&gt;2: // submitRegistrationData (email, số điện thoại, mật khẩu) (--&gt;)&lt;br&gt;1*a: // cancelRegistration (--&gt;)" style="endArrow=none;html=1;labelBackgroundColor=#ffffff;fontSize=10;align=center;" edge="1" parent="1" source="CM1-O-KH" target="CM1-O-FM"><mxGeometry relative="1" as="geometry" x="-0.9" /></mxCell><mxCell id="CM1-L2" value="1.1: // startRegistration (--&gt;)&lt;br&gt;1.1.1: // showRegistrationRequest (yêu cầu cung cấp email, số điện thoại, mật khẩu) (&lt;--)&lt;br&gt;2.1: // registerAccount (email, số điện thoại, mật khẩu) (--&gt;)&lt;br&gt;2.1.3: // rejectRegistration (quy tắc BR-81) (&lt;--) [email không đúng định dạng email chuẩn, kể cả để trống (4a)]&lt;br&gt;2.1.4: // rejectRegistration (quy tắc BR-82) (&lt;--) [email đúng, số điện thoại không đúng định dạng số điện thoại Việt Nam, kể cả để trống (5a)]&lt;br&gt;2.1.5: // rejectRegistration (quy tắc BR-99) (&lt;--) [email và số điện thoại đúng, mật khẩu ngắn hơn 8 ký tự, kể cả để trống (6a)]&lt;br&gt;2.1.7: // rejectRegistration (quy tắc BR-98) (&lt;--) [email hoặc số điện thoại đã thuộc tài khoản khách khác, kể cả khi tài khoản đó vừa được tạo cùng lúc bởi yêu cầu khác (7a)]&lt;br&gt;2.1.8: // showRegistrationSuccess (&lt;--) [email và số điện thoại chưa thuộc tài khoản khách nào khác, tài khoản đã được ghi nhận]&lt;br&gt;1*a.1: // cancelRegistration (--&gt;)&lt;br&gt;1*a.1.1: // showRegistrationCancelled (&lt;--)" style="endArrow=none;html=1;labelBackgroundColor=#ffffff;fontSize=10;align=center;" edge="1" parent="1" source="CM1-O-FM" target="CM1-O-CT"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="CM1-L3" value="2.1.1: «create» // draftCustomer (email, số điện thoại, mật khẩu) (--&gt;)&lt;br&gt;2.1.2: // checkRegistrationData (--&gt;)&lt;br&gt;2.1.6: // saveCustomer (--&gt;)" style="endArrow=none;html=1;labelBackgroundColor=#ffffff;fontSize=10;align=center;" edge="1" parent="1" source="CM1-O-CT" target="CM1-O-CU"><mxGeometry relative="1" as="geometry" x="0.8" /></mxCell></root></mxGraphModel></diagram></mxfile>