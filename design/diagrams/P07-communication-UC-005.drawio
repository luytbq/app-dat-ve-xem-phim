          <mxCell id="CM1-O-ES" value="&lt;u&gt;:EmailService&lt;/u&gt;&lt;br&gt;«boundary»" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="960" y="25" width="160" height="50" as="geometry" /></mxCell>
