          <mxCell id="CM1-L9" value="2.1.4.2: // checkUnchangedSinceDisplayed (mốc hiển thị sơ đồ ghế) (--&gt;)" style="endArrow=none;html=1;labelBackgroundColor=#ffffff;fontSize=10;align=center;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="CM1-O-ST" target="CM1-O-ST"><mxGeometry relative="1" as="geometry" /></mxCell>
          <mxCell id="CM1-L10" value="2.1.4.4: // determineSeatPrice (loại phòng, định dạng phim, loại ghế, giờ bắt đầu) (--&gt;) [lặp: mỗi ghế đã chọn]" style="endArrow=none;html=1;labelBackgroundColor=#ffffff;fontSize=10;align=center;" edge="1" parent="1" source="CM1-O-ST" target="CM1-O-PL"><mxGeometry relative="1" as="geometry" x="-0.3" /></mxCell>
