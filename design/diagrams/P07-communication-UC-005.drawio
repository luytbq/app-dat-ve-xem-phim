          <mxCell id="CM1-L24" value="4.1.6: // provideBookingInfo (--&amp;gt;)" style="endArrow=none;html=1;labelBackgroundColor=#ffffff;fontSize=10;align=center;" edge="1" parent="1" source="CM1-O-C" target="CM1-O-BK"><mxGeometry relative="1" as="geometry" /></mxCell>
