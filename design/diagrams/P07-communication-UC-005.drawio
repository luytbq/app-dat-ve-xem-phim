          <mxCell id="CM1-L1" value="1: // selectShowtime (suất chiếu) (--&gt;)&lt;br&gt;2: // confirmSeatSelection (các ghế đã chọn) (--&gt;)&lt;br&gt;3: // requestOnlinePayment (--&gt;)" style="endArrow=none;html=1;labelBackgroundColor=#ffffff;fontSize=10;align=center;" edge="1" parent="1" source="CM1-O-K" target="CM1-O-BF"><mxGeometry relative="1" as="geometry" x="-0.4" /></mxCell>
          <mxCell id="CM1-L2" value="1.1: // startBooking (suất chiếu) (--&gt;)&lt;br&gt;1.1.3: // showSeatMap (suất chiếu, sơ đồ ghế) (&lt;--)&lt;br&gt;2.1: // requestSeatHold (các ghế đã chọn, khách đã đăng nhập nếu có) (--&gt;)&lt;br&gt;2.1.8: // showHeldSeats (ghế đã giữ, giá vé từng ghế, tổng tiền) (&lt;--)&lt;br&gt;3.1: // startOnlinePayment (--&gt;)" style="endArrow=none;html=1;labelBackgroundColor=#ffffff;fontSize=10;align=center;" edge="1" parent="1" source="CM1-O-BF" target="CM1-O-C"><mxGeometry relative="1" as="geometry" /></mxCell>
          <mxCell id="CM1-L3" value="1.1.1: // checkSaleOpen (thời điểm hiện tại) (--&gt;)&lt;br&gt;1.1.2: // provideSeatMap (--&gt;)&lt;br&gt;2.1.3: // checkSeatSelectionLimit (các ghế đã chọn) (--&gt;)&lt;br&gt;2.1.4: // holdSeats (khách, các ghế đã chọn, mốc hiển thị sơ đồ ghế) (--&gt;)" style="endArrow=none;html=1;labelBackgroundColor=#ffffff;fontSize=10;align=center;" edge="1" parent="1" source="CM1-O-C" target="CM1-O-ST"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="810" y="48.5" /><mxPoint x="990" y="48.5" /></Array></mxGeometry></mxCell>
          <mxCell id="CM1-L4" value="1.1.2.1: // provideSeatStatus (vị trí, loại ghế, trạng thái ghế) (--&gt;) [lặp: mỗi ghế của sơ đồ ghế]&lt;br&gt;2.1.4.3: // holdSeatFor (lần giữ ghế) (--&gt;) [lặp: mỗi ghế đã chọn]&lt;br&gt;2.1.4.5: // recordHeldPrice (giá vé) (--&gt;) [lặp: mỗi ghế đã chọn]" style="endArrow=none;html=1;labelBackgroundColor=#ffffff;fontSize=10;align=center;" edge="1" parent="1" source="CM1-O-ST" target="CM1-O-SS"><mxGeometry relative="1" as="geometry" x="-0.8" /></mxCell>
          <mxCell id="CM1-L5" value="2.1.1: // checkCustomerLoggedIn (--&gt;)&lt;br&gt;2.1.5: // startWaitingForHoldExpiry (BR-10) (--&gt;)" style="endArrow=none;html=1;labelBackgroundColor=#ffffff;fontSize=10;align=center;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="CM1-O-C" target="CM1-O-C"><mxGeometry relative="1" as="geometry" /></mxCell>
          <mxCell id="CM1-L6" value="2.1.2: // checkNoActiveSeatHold (--&gt;)" style="endArrow=none;html=1;labelBackgroundColor=#ffffff;fontSize=10;align=center;" edge="1" parent="1" source="CM1-O-C" target="CM1-O-CU"><mxGeometry relative="1" as="geometry" x="-0.2" /></mxCell>
