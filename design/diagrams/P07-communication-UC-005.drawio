          <mxCell id="CM2-O-K" value=":Khách" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="300" width="30" height="60" as="geometry" /></mxCell>
