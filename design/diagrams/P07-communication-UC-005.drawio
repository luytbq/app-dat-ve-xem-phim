          <mxCell id="CM1-L16" value="3.1.1.1: // createPaymentTransaction (tổng tiền, mã tham chiếu lần giữ ghế) (--&gt;)&lt;br&gt;4: // reportTransactionResult (thành công, mã giao dịch, mã tham chiếu lần giữ ghế, số tiền đã thanh toán) (&lt;--)" style="endArrow=none;html=1;labelBackgroundColor=#ffffff;fontSize=10;align=center;" edge="1" parent="1" source="CM1-O-PG" target="CM1-O-A7"><mxGeometry relative="1" as="geometry" /></mxCell>
          <mxCell id="CM1-L17" value="3.1.2.1: «create» // createPaymentTransaction (mã giao dịch, số tiền) (--&gt;)&lt;br&gt;4.1.1.1: // checkNotProcessed (mã giao dịch) (--&gt;)&lt;br&gt;4.1.1.3: // markProcessed (mã giao dịch) (--&gt;)" style="endArrow=none;html=1;labelBackgroundColor=#ffffff;fontSize=10;align=center;" edge="1" parent="1" source="CM1-O-SH" target="CM1-O-PT"><mxGeometry relative="1" as="geometry" /></mxCell>
          <mxCell id="CM1-L18" value="4.1: // handlePaymentReport (thành công, mã giao dịch, mã tham chiếu lần giữ ghế, số tiền đã thanh toán, thời điểm nhận báo) (--&gt;)" style="endArrow=none;html=1;labelBackgroundColor=#ffffff;fontSize=10;align=center;" edge="1" parent="1" source="CM1-O-PG" target="CM1-O-PC"><mxGeometry relative="1" as="geometry" /></mxCell>
          <mxCell id="CM1-L19" value="4.1.1: // settlePaymentReport (lần giữ ghế tìm theo mã giao dịch hoặc mã tham chiếu lần giữ ghế, kết quả, số tiền đã thanh toán, thời điểm nhận báo) (--&gt;)" style="endArrow=none;html=1;labelBackgroundColor=#ffffff;fontSize=10;align=center;" edge="1" parent="1" source="CM1-O-PC" target="CM1-O-SH"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="810" y="301.5" /><mxPoint x="990" y="301.5" /></Array></mxGeometry></mxCell>
