          <mxCell id="CM2-O-CU" value="&lt;u&gt;:Customer&lt;/u&gt;&lt;br&gt;«entity»" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="480" y="125" width="160" height="50" as="geometry" /></mxCell>
          <mxCell id="CM2-O-SH" value="&lt;u&gt;:SeatHold&lt;/u&gt;&lt;br&gt;«entity»" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="720" y="305" width="160" height="50" as="geometry" /></mxCell>
          <mxCell id="CM2-O-SS" value="&lt;u&gt;:SeatStatus&lt;/u&gt;&lt;br&gt;«entity»" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="720" y="525" width="160" height="50" as="geometry" /></mxCell>
          <mxCell id="CM2-O-PT" value="&lt;u&gt;:PaymentTransaction&lt;/u&gt;&lt;br&gt;«entity»" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="960" y="125" width="160" height="50" as="geometry" /></mxCell>
          <mxCell id="CM2-O-PG" value="&lt;u&gt;:PaymentGateway&lt;/u&gt;&lt;br&gt;«boundary»" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="240" y="125" width="160" height="50" as="geometry" /></mxCell>
          <mxCell id="CM2-O-A7" value=":Cổng thanh toán" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="120" width="30" height="60" as="geometry" /></mxCell>
          <mxCell id="CM2-L1" value="1.1.1a.1: // notifyRefusal (chưa tới thời điểm mở bán, BR-01) (--&amp;gt;) [suất chiếu chưa tới thời điểm mở bán (BR-01)]&lt;br&gt;1.1.1c.1: // notifyRefusal (suất chiếu đã bắt đầu, BR-45) (--&amp;gt;) [suất chiếu đã tới giờ bắt đầu (BR-45)]&lt;br&gt;2.1.1a.1: // requestLogin (giữ nguyên các ghế đã chọn, BR-03) (--&amp;gt;) [khách chưa đăng nhập (5a)]&lt;br&gt;2.1.1a.3: // requestSeatHold (các ghế đã chọn, thông tin đăng nhập) (&amp;lt;--) [khách chưa đăng nhập (5a)]&lt;br&gt;2.1.2b.1: // notifyRefusal (đang có lần giữ ghế chưa kết thúc, BR-04) (--&amp;gt;) [đã có lần giữ ghế chưa kết thúc (BR-04)]&lt;br&gt;2.1.3a.1: // notifyRefusal (vượt số ghế tối đa, BR-05) (--&amp;gt;) [số ghế đã chọn vượt số ghế tối đa (BR-05, BR-06)]&lt;br&gt;2.1.4c.1: // notifyRefusal (đang có lần giữ ghế chưa kết thúc, BR-04) (--&amp;gt;) [tác nhân đang có lần giữ ghế chưa kết thúc (BR-04)]&lt;br&gt;2.1.4d.1: // notifyRefusal (suất chiếu đã thay đổi hoặc không còn, BR-54) (--&amp;gt;) [không thuộc 7c; suất chiếu đã bị sửa hoặc xoá kể từ lúc hiển thị sơ đồ ghế (BR-54)]&lt;br&gt;2.1.4e.1: // notifyRefusal (không xác định được giá vé, BR-72) (--&amp;gt;) [không thuộc 7c, 7d, 7a; thiếu giá cho ít nhất một ghế (BR-72)]&lt;br&gt;2.1.4a.1: // notifyRefusal (các ghế không còn trống, BR-07) (--&amp;gt;) [có ghế đã chọn không còn trống (BR-07, BR-09)]&lt;br&gt;2.1.5(7b).5: // notifyRefusal (hết thời gian giữ ghế) (--&amp;gt;)&lt;br&gt;2.1.7(*a).1: // cancelSeatHold (&amp;lt;--)&lt;br&gt;3.1.1a.1: // notifyRefusal (chưa tạo được thanh toán, BR-90) (--&amp;gt;) [cổng từ chối hoặc không trả lời trong 30 giây (BR-90)]&lt;br&gt;4a.1.5: // notifyRefusal (thanh toán không thành công) (--&amp;gt;) [cổng báo giao dịch thanh toán thất bại]" style="endArrow=none;html=1;labelBackgroundColor=#ffffff;fontSize=10;align=center;" edge="1" parent="1" source="CM2-O-C" target="CM2-O-BF"><mxGeometry relative="1" as="geometry" /></mxCell>
          <mxCell id="CM2-L2" value="2.1.1a.2: // provideCredentials (email hoặc số điện thoại, mật khẩu) (--&amp;gt;) [khách chưa đăng nhập (5a)]&lt;br&gt;2.1.7(*a): // cancelSeatHold (--&amp;gt;)" style="endArrow=none;html=1;labelBackgroundColor=#ffffff;fontSize=10;align=center;" edge="1" parent="1" source="CM2-O-K" target="CM2-O-BF"><mxGeometry relative="1" as="geometry" /></mxCell>
          <mxCell id="CM2-L3" value="2.1.1a.4: // authenticateCustomer (email hoặc số điện thoại, mật khẩu) (--&amp;gt;) [khách chưa đăng nhập (5a)]" style="endArrow=none;html=1;labelBackgroundColor=#ffffff;fontSize=10;align=center;" edge="1" parent="1" source="CM2-O-C" target="CM2-O-CU"><mxGeometry relative="1" as="geometry" x="0.2" /></mxCell>
