    <diagram id="CM2" name="Luồng thay thế và ngoại lệ (SD2 đến SD10)">
      <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="900" math="0" shadow="0">
        <root>
