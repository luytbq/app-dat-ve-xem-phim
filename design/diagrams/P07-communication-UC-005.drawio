          <mxCell id="CM1-O-A8" value=":Dịch vụ email" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;" vertex="1" parent="1"><mxGeometry x="1240" y="20" width="30" height="60" as="geometry" /></mxCell>
          <mxCell id="CM1-L1" value="1: // selectShowtime (suất chiếu) (--&amp;gt;)&lt;br&gt;2: // confirmSeatSelection (các ghế đã chọn) (--&amp;gt;)&lt;br&gt;3: // requestOnlinePayment (--&amp;gt;)" style="endArrow=none;html=1;labelBackgroundColor=#ffffff;fontSize=10;align=center;" edge="1" parent="1" source="CM1-O-K" target="CM1-O-BF"><mxGeometry relative="1" as="geometry" x="-0.2" /></mxCell>
          <mxCell id="CM1-L2" value="1.1: // startBooking (suất chiếu) (--&amp;gt;)&lt;br&gt;1.1.3: // showSeatMap (suất chiếu, sơ đồ ghế) (&amp;lt;--)&lt;br&gt;2.1: // requestSeatHold (các ghế đã chọn, khách đã đăng nhập nếu có) (--&amp;gt;)&lt;br&gt;2.1.8: // showHeldSeats (ghế đã giữ, giá vé từng ghế, tổng tiền) (&amp;lt;--)&lt;br&gt;3.1: // startOnlinePayment (--&amp;gt;)&lt;br&gt;4.1.7: // showBookingSuccess (mã đặt vé, các vé) (&amp;lt;--)" style="endArrow=none;html=1;labelBackgroundColor=#ffffff;fontSize=10;align=center;" edge="1" parent="1" source="CM1-O-BF" target="CM1-O-C"><mxGeometry relative="1" as="geometry" /></mxCell>
          <mxCell id="CM1-L3" value="1.1.1: // checkSaleOpen (thời điểm hiện tại) (--&amp;gt;)&lt;br&gt;1.1.2: // provideSeatMap (--&amp;gt;)&lt;br&gt;2.1.3: // checkSeatSelectionLimit (các ghế đã chọn) (--&amp;gt;)&lt;br&gt;2.1.4: // holdSeats (khách, các ghế đã chọn, mốc hiển thị sơ đồ ghế) (--&amp;gt;)" style="endArrow=none;html=1;labelBackgroundColor=#ffffff;fontSize=10;align=center;" edge="1" parent="1" source="CM1-O-C" target="CM1-O-ST"><mxGeometry relative="1" as="geometry" x="0.6" /></mxCell>
          <mxCell id="CM1-L4" value="1.1.2.1: // provideSeatStatus (vị trí, loại ghế, trạng thái ghế) (--&amp;gt;) [lặp: mỗi ghế của sơ đồ ghế]&lt;br&gt;2.1.4.3: // holdSeatFor (lần giữ ghế) (--&amp;gt;) [lặp: mỗi ghế đã chọn]&lt;br&gt;2.1.4.6: // recordHeldPrice (giá vé) (--&amp;gt;) [lặp: mỗi ghế đã chọn]" style="endArrow=none;html=1;labelBackgroundColor=#ffffff;fontSize=10;align=center;" edge="1" parent="1" source="CM1-O-ST" target="CM1-O-SS"><mxGeometry relative="1" as="geometry" /></mxCell>
          <mxCell id="CM1-L5" value="2.1.1: // checkCustomerLoggedIn (--&amp;gt;)&lt;br&gt;2.1.5: // startWaitingForHoldExpiry (BR-10) (--&amp;gt;)&lt;br&gt;4.1.1: // stopWaitingForHoldExpiry (--&amp;gt;)" style="endArrow=none;html=1;labelBackgroundColor=#ffffff;fontSize=10;align=center;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="CM1-O-C" target="CM1-O-C"><mxGeometry relative="1" as="geometry" /></mxCell>
          <mxCell id="CM1-L6" value="2.1.2: // checkNoActiveSeatHold (--&amp;gt;)" style="endArrow=none;html=1;labelBackgroundColor=#ffffff;fontSize=10;align=center;" edge="1" parent="1" source="CM1-O-C" target="CM1-O-CU"><mxGeometry relative="1" as="geometry" x="-0.3" /></mxCell>
          <mxCell id="CM1-L7" value="2.1.4.1: «create» // createSeatHold (khách, suất chiếu) (--&amp;gt;)" style="endArrow=none;html=1;labelBackgroundColor=#ffffff;fontSize=10;align=center;" edge="1" parent="1" source="CM1-O-ST" target="CM1-O-SH"><mxGeometry relative="1" as="geometry" x="0.5" /></mxCell>
          <mxCell id="CM1-L8" value="2.1.4.1.1: // checkNoActiveSeatHold (--&amp;gt;)" style="endArrow=none;html=1;labelBackgroundColor=#ffffff;fontSize=10;align=center;" edge="1" parent="1" source="CM1-O-SH" target="CM1-O-CU"><mxGeometry relative="1" as="geometry" x="0.3" /></mxCell>
          <mxCell id="CM1-L9" value="2.1.4.2: // checkUnchangedSinceDisplayed (mốc hiển thị sơ đồ ghế) (--&amp;gt;)&lt;br&gt;2.1.4.4: // determineTimeBand (--&amp;gt;)" style="endArrow=none;html=1;labelBackgroundColor=#ffffff;fontSize=10;align=center;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="CM1-O-ST" target="CM1-O-ST"><mxGeometry relative="1" as="geometry" /></mxCell>
          <mxCell id="CM1-L10" value="2.1.4.5: // determineSeatPrice (loại phòng, định dạng phim, loại ghế, khung giờ) (--&amp;gt;) [lặp: mỗi ghế đã chọn]" style="endArrow=none;html=1;labelBackgroundColor=#ffffff;fontSize=10;align=center;" edge="1" parent="1" source="CM1-O-ST" target="CM1-O-PL"><mxGeometry relative="1" as="geometry" /></mxCell>
          <mxCell id="CM1-L11" value="2.1.6: // updateSeatMap (ghế đã được giữ) (--&amp;gt;)&lt;br&gt;4.1.3: // updateSeatMap (ghế đã bán) (--&amp;gt;)" style="endArrow=none;html=1;labelBackgroundColor=#ffffff;fontSize=10;align=center;" edge="1" parent="1" source="CM1-O-C" target="CM1-O-WF"><mxGeometry relative="1" as="geometry" /></mxCell>
          <mxCell id="CM1-L12" value="2.1.7: // provideHoldSummary (--&amp;gt;)&lt;br&gt;3.1.2: // recordPaymentTransaction (mã giao dịch, tổng tiền) (--&amp;gt;)&lt;br&gt;4.1.2: // completeSaleOnPaymentSuccess (mã giao dịch, thời điểm nhận báo) (--&amp;gt;)&lt;br&gt;4.1.4: // issueBooking (--&amp;gt;)" style="endArrow=none;html=1;labelBackgroundColor=#ffffff;fontSize=10;align=center;" edge="1" parent="1" source="CM1-O-C" target="CM1-O-SH"><mxGeometry relative="1" as="geometry" /></mxCell>
          <mxCell id="CM1-L13" value="2.1.7.1: // provideHeldSeatInfo (vị trí, loại ghế, giá vé đã chốt) (--&amp;gt;) [lặp: mỗi ghế đã giữ]&lt;br&gt;4.1.2.3: // markSold (--&amp;gt;) [lặp: mỗi ghế đang giữ]" style="endArrow=none;html=1;labelBackgroundColor=#ffffff;fontSize=10;align=center;" edge="1" parent="1" source="CM1-O-SH" target="CM1-O-SS"><mxGeometry relative="1" as="geometry" /></mxCell>
          <mxCell id="CM1-L14" value="2.1.7.2: // calculateTotalAmount (--&amp;gt;)&lt;br&gt;4.1.2.1: // checkHoldStillActive (thời điểm nhận báo) (--&amp;gt;)&lt;br&gt;4.1.2.4: // endHold (Đã hoàn tất) (--&amp;gt;)" style="endArrow=none;html=1;labelBackgroundColor=#ffffff;fontSize=10;align=center;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="CM1-O-SH" target="CM1-O-SH"><mxGeometry relative="1" as="geometry" /></mxCell>
          <mxCell id="CM1-L15" value="3.1.1: // createPaymentTransaction (tổng tiền, mã tham chiếu lần giữ ghế) (--&amp;gt;)&lt;br&gt;4.1: // handlePaymentResult (thành công, mã giao dịch, mã tham chiếu lần giữ ghế) (&amp;lt;--)" style="endArrow=none;html=1;labelBackgroundColor=#ffffff;fontSize=10;align=center;" edge="1" parent="1" source="CM1-O-C" target="CM1-O-PG"><mxGeometry relative="1" as="geometry" /></mxCell>
          <mxCell id="CM1-L16" value="3.1.1.1: // createPaymentTransaction (tổng tiền, mã tham chiếu lần giữ ghế) (--&amp;gt;)&lt;br&gt;4: // reportTransactionResult (thành công, mã giao dịch, mã tham chiếu lần giữ ghế) (&amp;lt;--)" style="endArrow=none;html=1;labelBackgroundColor=#ffffff;fontSize=10;align=center;" edge="1" parent="1" source="CM1-O-PG" target="CM1-O-A7"><mxGeometry relative="1" as="geometry" /></mxCell>
          <mxCell id="CM1-L17" value="3.1.2.1: «create» // createPaymentTransaction (mã giao dịch, số tiền) (--&amp;gt;)&lt;br&gt;4.1.2.2: // markProcessed (mã giao dịch) (--&amp;gt;)" style="endArrow=none;html=1;labelBackgroundColor=#ffffff;fontSize=10;align=center;" edge="1" parent="1" source="CM1-O-SH" target="CM1-O-PT"><mxGeometry relative="1" as="geometry" /></mxCell>
          <mxCell id="CM1-L18" value="4.1.4.1: «create» // createBooking (suất chiếu, các ghế đã bán) (--&amp;gt;)" style="endArrow=none;html=1;labelBackgroundColor=#ffffff;fontSize=10;align=center;" edge="1" parent="1" source="CM1-O-SH" target="CM1-O-BK"><mxGeometry relative="1" as="geometry" x="-0.6" /></mxCell>
          <mxCell id="CM1-L19" value="4.1.4.1.1: // generateBookingCode (BR-80) (--&amp;gt;)" style="endArrow=none;html=1;labelBackgroundColor=#ffffff;fontSize=10;align=center;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="CM1-O-BK" target="CM1-O-BK"><mxGeometry relative="1" as="geometry" /></mxCell>
          <mxCell id="CM1-L20" value="4.1.4.1.2: «create» // createTicket (ghế, giá vé đã chốt, suất chiếu) (--&amp;gt;) [lặp: mỗi ghế đã bán]&lt;br&gt;4.1.6.1: // provideTicketContent (--&amp;gt;) [lặp: mỗi vé của lần đặt]" style="endArrow=none;html=1;labelBackgroundColor=#ffffff;fontSize=10;align=center;" edge="1" parent="1" source="CM1-O-BK" target="CM1-O-TK"><mxGeometry relative="1" as="geometry" /></mxCell>
          <mxCell id="CM1-L21" value="4.1.4.1.2.1: // generateQrCode (--&amp;gt;) [lặp: mỗi ghế đã bán]" style="endArrow=none;html=1;labelBackgroundColor=#ffffff;fontSize=10;align=center;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="CM1-O-TK" target="CM1-O-TK"><mxGeometry relative="1" as="geometry" /></mxCell>
          <mxCell id="CM1-L22" value="4.1.5: // sendTicketsEmail (khách, các vé) (--&amp;gt;)" style="endArrow=none;html=1;labelBackgroundColor=#ffffff;fontSize=10;align=center;" edge="1" parent="1" source="CM1-O-C" target="CM1-O-ES"><mxGeometry relative="1" as="geometry" /></mxCell>
