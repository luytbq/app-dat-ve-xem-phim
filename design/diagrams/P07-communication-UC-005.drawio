          <mxCell id="CM1-L12" value="2.1.7: // provideHoldSummary (--&gt;)&lt;br&gt;3.1.2: // recordPaymentTransaction (mã giao dịch, tổng tiền) (--&gt;)" style="endArrow=none;html=1;labelBackgroundColor=#ffffff;fontSize=10;align=center;" edge="1" parent="1" source="CM1-O-C" target="CM1-O-SH"><mxGeometry relative="1" as="geometry" x="-0.6" /></mxCell>
          <mxCell id="CM1-L13" value="2.1.7.1: // provideHeldSeatInfo (vị trí, loại ghế, giá vé đã chốt) (--&gt;) [lặp: mỗi ghế đã giữ]&lt;br&gt;4.1.1.4: // markSold (--&gt;) [lặp: mỗi ghế đang giữ]" style="endArrow=none;html=1;labelBackgroundColor=#ffffff;fontSize=10;align=center;" edge="1" parent="1" source="CM1-O-SH" target="CM1-O-SS"><mxGeometry relative="1" as="geometry" x="0.6" /></mxCell>
          <mxCell id="CM1-L14" value="2.1.7.2: // calculateTotalAmount (--&gt;)&lt;br&gt;4.1.1.2: // checkHoldStillActive (thời điểm nhận báo) (--&gt;)&lt;br&gt;4.1.1.5: // endHold (Đã hoàn tất) (--&gt;)&lt;br&gt;4.1.1.6: // issueBooking (--&gt;)" style="endArrow=none;html=1;labelBackgroundColor=#ffffff;fontSize=10;align=center;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="CM1-O-SH" target="CM1-O-SH"><mxGeometry relative="1" as="geometry" /></mxCell>
