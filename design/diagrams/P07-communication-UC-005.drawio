          <mxCell id="CM1-O-BK" value="&lt;u&gt;:Booking&lt;/u&gt;&lt;br&gt;«entity»" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="960" y="445" width="160" height="50" as="geometry" /></mxCell>
          <mxCell id="CM1-O-TK" value="&lt;u&gt;:Ticket&lt;/u&gt;&lt;br&gt;«entity»" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="1200" y="445" width="160" height="50" as="geometry" /></mxCell>
