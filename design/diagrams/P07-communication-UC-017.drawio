<mxfile host="app.diagrams.net"><diagram id="CM1" name="CM1 - Luồng chính (SD1a, SD1b)"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="440" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="CM1-O-QT" value=":Quản trị viên" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="40" height="60" as="geometry" /></mxCell><mxCell id="CM1-O-FM" value="&lt;u&gt;:ManageStaffAccountsForm&lt;/u&gt;&lt;br&gt;«boundary»" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="240" y="140" width="160" height="60" as="geometry" /></mxCell><mxCell id="CM1-O-CT" value="&lt;u&gt;:ManageStaffAccountsController&lt;/u&gt;&lt;br&gt;«control»" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="540" y="140" width="160" height="60" as="geometry" /></mxCell><mxCell id="CM1-O-SF" value="&lt;u&gt;:Staff&lt;/u&gt;&lt;br&gt;«entity»" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="840" y="40" width="160" height="60" as="geometry" /></mxCell><mxCell id="CM1-O-CI" value="&lt;u&gt;:Cinema&lt;/u&gt;&lt;br&gt;«entity»" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="840" y="240" width="160" height="60" as="geometry" /></mxCell><mxCell id="CM1-L1" value="1: // requestCreateStaff (--&gt;)&lt;br&gt;2: // submitStaffData (email, họ tên, mật khẩu ban đầu, vai trò, cụm rạp) (--&gt;)" style="endArrow=none;html=1;labelBackgroundColor=#ffffff;fontSize=10;align=center;" edge="1" parent="1" source="CM1-O-QT" target="CM1-O-FM"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="CM1-L2" value="1.1: // startStaffCreation (--&gt;)&lt;br&gt;1.1.3: // showStaffAccountChoices (các cụm rạp của chuỗi, bốn vai trò) (&lt;--)&lt;br&gt;2.1: // saveStaffAccount (email, họ tên, mật khẩu ban đầu, vai trò, cụm rạp) (--&gt;)&lt;br&gt;2.1.3: // rejectStaffAccount (điều kiện email, Q-163) (&lt;--) [email không theo định dạng email chuẩn (4c)]&lt;br&gt;2.1.4: // rejectStaffAccount (điều kiện họ tên, Q-163) (&lt;--) [email đúng, họ tên rỗng (4d)]&lt;br&gt;2.1.5: // rejectStaffAccount (quy tắc BR-79) (&lt;--) [email và họ tên đúng, nhân viên không có đúng một vai trò trong bốn vai trò (4a)]&lt;br&gt;2.1.6: // rejectStaffAccount (quy tắc BR-78) (&lt;--) [nhân viên có đúng một vai trò, cụm rạp được gán không phù hợp vai trò (4b)]&lt;br&gt;2.1.8: // rejectStaffAccount (quy tắc BR-95) (&lt;--) [email đã thuộc tài khoản nhân viên khác, kể cả khi tài khoản đó vừa được lưu cùng lúc bởi yêu cầu khác (5a)]&lt;br&gt;2.1.10: // showSavedStaffAccount (tài khoản đã lưu) (&lt;--) [email chưa thuộc tài khoản nhân viên nào khác, tài khoản đã được lưu ở trạng thái đang hoạt động]" style="endArrow=none;html=1;labelBackgroundColor=#ffffff;fontSize=10;align=center;" edge="1" parent="1" source="CM1-O-FM" target="CM1-O-CT"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="CM1-L3" value="1.1.1: // provideRoleChoices (--&gt;)&lt;br&gt;2.1.1: «create» // draftStaff (email, họ tên, mật khẩu ban đầu, vai trò, cụm rạp) (--&gt;)&lt;br&gt;2.1.2: // checkStaffData (--&gt;)&lt;br&gt;2.1.7: // saveStaff (--&gt;)&lt;br&gt;2.1.9: // provideStaffInfo (--&gt;) [email chưa thuộc tài khoản nhân viên nào khác, tài khoản đã được lưu ở trạng thái đang hoạt động]" style="endArrow=none;html=1;labelBackgroundColor=#ffffff;fontSize=10;align=center;" edge="1" parent="1" source="CM1-O-CT" target="CM1-O-SF"><mxGeometry relative="1" as="geometry" x="-0.5" /></mxCell><mxCell id="CM1-L4" value="1.1.2: // provideCinemaName (--&gt;) [lặp: mỗi cụm rạp của chuỗi]" style="endArrow=none;html=1;labelBackgroundColor=#ffffff;fontSize=10;align=center;" edge="1" parent="1" source="CM1-O-CT" target="CM1-O-CI"><mxGeometry relative="1" as="geometry" x="0.3" /></mxCell><mxCell id="CM1-L5" value="2.1.9.1: // provideCinemaName (--&gt;) [email chưa thuộc tài khoản nhân viên nào khác, tài khoản đã được lưu ở trạng thái đang hoạt động]" style="endArrow=none;html=1;labelBackgroundColor=#ffffff;fontSize=10;align=center;" edge="1" parent="1" source="CM1-O-SF" target="CM1-O-CI"><mxGeometry relative="1" as="geometry" x="0.6" /></mxCell></root></mxGraphModel></diagram><diagram id="CM2" name="CM2 - Luồng 1a đến 1e và *a (SD2a đến SD7)"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="440" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="CM2-O-QT" value=":Quản trị viên" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="40" height="60" as="geometry" /></mxCell><mxCell id="CM2-O-FM" value="&lt;u&gt;:ManageStaffAccountsForm&lt;/u&gt;&lt;br&gt;«boundary»" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="240" y="140" width="160" height="60" as="geometry" /></mxCell><mxCell id="CM2-O-CT" value="&lt;u&gt;:ManageStaffAccountsController&lt;/u&gt;&lt;br&gt;«control»" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="540" y="140" width="160" height="60" as="geometry" /></mxCell><mxCell id="CM2-O-SF" value="&lt;u&gt;:Staff&lt;/u&gt;&lt;br&gt;«entity»" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="840" y="40" width="160" height="60" as="geometry" /></mxCell><mxCell id="CM2-O-CI" value="&lt;u&gt;:Cinema&lt;/u&gt;&lt;br&gt;«entity»" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="840" y="240" width="160" height="60" as="geometry" /></mxCell><mxCell id="CM2-L1" value="1a: // requestUpdateStaff (--&gt;)&lt;br&gt;1a.2: // selectStaff (tài khoản nhân viên cần cập nhật) (--&gt;)&lt;br&gt;1a.3: // submitRoleAndCinema (vai trò, cụm rạp) (--&gt;)&lt;br&gt;1b: // requestLockStaff (--&gt;)&lt;br&gt;1b.2: // selectStaff (tài khoản nhân viên cần khoá) (--&gt;)&lt;br&gt;1c: // requestUnlockStaff (--&gt;)&lt;br&gt;1c.2: // selectStaff (tài khoản nhân viên cần mở khoá) (--&gt;)&lt;br&gt;1d: // requestRenameStaff (--&gt;)&lt;br&gt;1d.2: // selectStaff (tài khoản nhân viên cần sửa họ tên) (--&gt;)&lt;br&gt;1d.3: // submitNewFullName (họ tên mới) (--&gt;)&lt;br&gt;1e: // requestResetStaffPassword (--&gt;)&lt;br&gt;1e.2: // selectStaff (tài khoản nhân viên cần đặt lại mật khẩu) (--&gt;)&lt;br&gt;1e.3: // submitNewPassword (mật khẩu mới) (--&gt;)&lt;br&gt;1*a: // cancelStaffRequest (--&gt;)" style="endArrow=none;html=1;labelBackgroundColor=#ffffff;fontSize=10;align=center;" edge="1" parent="1" source="CM2-O-QT" target="CM2-O-FM"><mxGeometry relative="1" as="geometry" x="-0.9" /></mxCell><mxCell id="CM2-L2" value="1a.1: // startStaffAction (cập nhật cụm rạp hoặc vai trò) (--&gt;)&lt;br&gt;1a.1.2: // showStaffList (danh sách tài khoản nhân viên) (&lt;--)&lt;br&gt;1a.2.1: // openStaffForUpdate (tài khoản đã chọn) (--&gt;)&lt;br&gt;1a.2.1.4: // showStaffForUpdate (thông tin hiện tại, các cụm rạp, bốn vai trò) (&lt;--)&lt;br&gt;1a.3.1: // updateStaffAccount (tài khoản đã chọn, vai trò, cụm rạp) (--&gt;)&lt;br&gt;1a.3.1.2: // rejectStaffAccount (quy tắc BR-79) (&lt;--) [nhân viên không có đúng một vai trò trong bốn vai trò (4a)]&lt;br&gt;1a.3.1.3: // rejectStaffAccount (quy tắc BR-78) (&lt;--) [nhân viên có đúng một vai trò, cụm rạp được gán không phù hợp vai trò (4b)]&lt;br&gt;1a.3.1.5: // rejectStaffAccount (quy tắc BR-102) (&lt;--) [tài khoản đã bị yêu cầu khác thay đổi kể từ lúc hiển thị (5b)]&lt;br&gt;1a.3.1.7: // showSavedStaffAccount (tài khoản đã lưu) (&lt;--) [tài khoản chưa bị thay đổi, vai trò và cụm rạp mới đã được lưu]&lt;br&gt;1b.1: // startStaffAction (khoá tài khoản) (--&gt;)&lt;br&gt;1b.1.2: // showStaffList (danh sách tài khoản nhân viên) (&lt;--)&lt;br&gt;1b.2.1: // changeStaffStatus (tài khoản đã chọn, khoá) (--&gt;)&lt;br&gt;1b.2.1.2: // notifyStaffStatusUnchanged (tài khoản đã bị khoá) (&lt;--) [tài khoản đã chọn đã ở trạng thái bị khoá (1b3a)]&lt;br&gt;1b.2.1.3: // rejectStaffAccount (quy tắc BR-102) (&lt;--) [tài khoản đã bị yêu cầu khác thay đổi kể từ lúc hiển thị (1b3b)]&lt;br&gt;1b.2.1.4: // notifyStaffChanged (đã khoá tài khoản) (&lt;--) [tài khoản chưa bị thay đổi, đã được khoá]&lt;br&gt;1c.1: // startStaffAction (mở khoá tài khoản) (--&gt;)&lt;br&gt;1c.1.2: // showStaffList (danh sách tài khoản nhân viên) (&lt;--)&lt;br&gt;1c.2.1: // changeStaffStatus (tài khoản đã chọn, mở khoá) (--&gt;)&lt;br&gt;1c.2.1.2: // notifyStaffStatusUnchanged (tài khoản đang hoạt động) (&lt;--) [tài khoản đã chọn đang hoạt động (1c3a)]&lt;br&gt;1c.2.1.3: // rejectStaffAccount (quy tắc BR-102) (&lt;--) [tài khoản đã bị yêu cầu khác thay đổi kể từ lúc hiển thị (1c3b)]&lt;br&gt;1c.2.1.4: // notifyStaffChanged (đã mở khoá tài khoản) (&lt;--) [tài khoản chưa bị thay đổi, đã được mở khoá]&lt;br&gt;1d.1: // startStaffAction (sửa họ tên) (--&gt;)&lt;br&gt;1d.1.2: // showStaffList (danh sách tài khoản nhân viên) (&lt;--)&lt;br&gt;1d.3.1: // renameStaffAccount (tài khoản đã chọn, họ tên mới) (--&gt;)&lt;br&gt;1d.3.1.2: // rejectStaffAccount (điều kiện họ tên, Q-163) (&lt;--) [họ tên mới rỗng (1d4a)]&lt;br&gt;1d.3.1.3: // rejectStaffAccount (quy tắc BR-102) (&lt;--) [họ tên mới không rỗng, tài khoản đã bị yêu cầu khác thay đổi kể từ lúc hiển thị (1d4b)]&lt;br&gt;1d.3.1.4: // notifyStaffChanged (đã sửa họ tên) (&lt;--) [họ tên mới đã được lưu]&lt;br&gt;1e.1: // startStaffAction (đặt lại mật khẩu) (--&gt;)&lt;br&gt;1e.1.2: // showStaffList (danh sách tài khoản nhân viên) (&lt;--)&lt;br&gt;1e.3.1: // resetStaffAccountPassword (tài khoản đã chọn, mật khẩu mới) (--&gt;)&lt;br&gt;1e.3.1.2: // rejectStaffAccount (quy tắc BR-102) (&lt;--) [tài khoản đã bị yêu cầu khác thay đổi kể từ lúc hiển thị (1e4a)]&lt;br&gt;1e.3.1.3: // notifyStaffChanged (đã đặt lại mật khẩu) (&lt;--) [mật khẩu mới đã được lưu]&lt;br&gt;1*a.1: // cancelStaffRequest (--&gt;)&lt;br&gt;1*a.1.1: // showStaffRequestCancelled (&lt;--)" style="endArrow=none;html=1;labelBackgroundColor=#ffffff;fontSize=10;align=center;" edge="1" parent="1" source="CM2-O-FM" target="CM2-O-CT"><mxGeometry relative="1" as="geometry" x="-0.4" /></mxCell><mxCell id="CM2-L3" value="1a.1.1: // provideStaffInfo (--&gt;) [lặp: mỗi tài khoản nhân viên, không gồm tài khoản quản trị viên]&lt;br&gt;1a.2.1.1: // provideStaffInfo (--&gt;)&lt;br&gt;1a.2.1.2: // provideRoleChoices (--&gt;)&lt;br&gt;1a.3.1.1: // checkStaffData (vai trò, cụm rạp) (--&gt;)&lt;br&gt;1a.3.1.4: // saveStaffChanges (vai trò, cụm rạp) (--&gt;)&lt;br&gt;1a.3.1.6: // provideStaffInfo (--&gt;) [tài khoản chưa bị thay đổi, vai trò và cụm rạp mới đã được lưu]&lt;br&gt;1b.1.1: // provideStaffInfo (--&gt;) [lặp: mỗi tài khoản nhân viên, không gồm tài khoản quản trị viên]&lt;br&gt;1b.2.1.1: // lockStaff (--&gt;)&lt;br&gt;1c.1.1: // provideStaffInfo (--&gt;) [lặp: mỗi tài khoản nhân viên, không gồm tài khoản quản trị viên]&lt;br&gt;1c.2.1.1: // unlockStaff (--&gt;)&lt;br&gt;1d.1.1: // provideStaffInfo (--&gt;) [lặp: mỗi tài khoản nhân viên, không gồm tài khoản quản trị viên]&lt;br&gt;1d.3.1.1: // renameStaff (họ tên mới) (--&gt;)&lt;br&gt;1e.1.1: // provideStaffInfo (--&gt;) [lặp: mỗi tài khoản nhân viên, không gồm tài khoản quản trị viên]&lt;br&gt;1e.3.1.1: // resetStaffPassword (mật khẩu mới) (--&gt;)" style="endArrow=none;html=1;labelBackgroundColor=#ffffff;fontSize=10;align=center;" edge="1" parent="1" source="CM2-O-CT" target="CM2-O-SF"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="CM2-L4" value="1a.1.1.1: // provideCinemaName (--&gt;) [lặp: mỗi tài khoản nhân viên, không gồm tài khoản quản trị viên]&lt;br&gt;1a.2.1.1.1: // provideCinemaName (--&gt;)&lt;br&gt;1a.3.1.6.1: // provideCinemaName (--&gt;) [tài khoản chưa bị thay đổi, vai trò và cụm rạp mới đã được lưu]&lt;br&gt;1b.1.1.1: // provideCinemaName (--&gt;) [lặp: mỗi tài khoản nhân viên, không gồm tài khoản quản trị viên]&lt;br&gt;1c.1.1.1: // provideCinemaName (--&gt;) [lặp: mỗi tài khoản nhân viên, không gồm tài khoản quản trị viên]&lt;br&gt;1d.1.1.1: // provideCinemaName (--&gt;) [lặp: mỗi tài khoản nhân viên, không gồm tài khoản quản trị viên]&lt;br&gt;1e.1.1.1: // provideCinemaName (--&gt;) [lặp: mỗi tài khoản nhân viên, không gồm tài khoản quản trị viên]" style="endArrow=none;html=1;labelBackgroundColor=#ffffff;fontSize=10;align=center;" edge="1" parent="1" source="CM2-O-SF" target="CM2-O-CI"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="CM2-L5" value="1a.2.1.3: // provideCinemaName (--&gt;) [lặp: mỗi cụm rạp của chuỗi]" style="endArrow=none;html=1;labelBackgroundColor=#ffffff;fontSize=10;align=center;" edge="1" parent="1" source="CM2-O-CT" target="CM2-O-CI"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>