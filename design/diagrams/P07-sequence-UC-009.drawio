tive="1" as="geometry"><mxPoint x="50" y="1000" as="sourcePoint"/><mxPoint x="1120" y="1000" as="targetPoint"/></mxGeometry></mxCell><mxCell id="SD1b-F4-O3" value="[vé thuộc suất chiếu khác suất chiếu đang soát]" style="text;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="60" y="1000" width="1030" height="20" as="geometry"/></mxCell><mxCell id="SD1b-F4-O4-SEP" value="" style="endArrow=none;dashed=1;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="50" y="1070" as="sourcePoint"/><mxPoint x="1120" y="1070" as="targetPoint"/></mxGeometry></mxCell><mxCell id="SD1b-F4-O4" value="[vé đã sử dụng, kể cả khi nhân viên soát vé khác vừa soát chính vé đó]" style="text;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="60" y="1070" width="1030" height="20" as="geometry"/></mxCell><mxCell id="SD1b-F4-O5-SEP" value="" style="endArrow=none;dashed=1;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="50" y="1140" as="sourcePoint"/><mxPoint x="1120" y="1140" as="targetPoint"/></mxGeometry></mxCell><mxCell id="SD1b-F4-O5" value="[vé đã huỷ, kể cả khi vừa huỷ ở UC-008]" style="text;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="60" y="1140" width="1030" height="20" as="geometry"/></mxCell><mxCell id="SD1b-N1" value="Bước 4 và 5 là một thao tác không chia cắt trên vé; loại trừ với việc huỷ chính vé đó ở UC-008 (BR-24, BR-30)" style="shape=note;whiteSpace=wrap;html=1;size=14;" vertex="1" parent="1"><mxGeometry x="70" y="490" width="420" height="40" as="geometry"/></mxCell><mxCell id="SD1b-N2" value="Tiếp tục bước 7: nhân viên soát vé quét vé kế tiếp (lặp từ message 2); hết vé cần soát thì thoát vòng lặp" style="shape=note;whiteSpace=wrap;html=1;size=14;" vertex="1" parent="1"><mxGeometry x="60" y="1230" width="420" height="40" as="geometry"/></mxCell><mxCell id="SD1b-M-2" value="2: // scanTicketQr (mã QR trên vé)" style="endArrow=block;endFill=1;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="100" y="190" as="sourcePoint"/><mxPoint x="260" y="190" as="targetPoint"/></mxGeometry></mxCell><mxCell id="SD1b-M-2.1" value="2.1: // checkTicket (mã QR)" style="endArrow=block;endFill=1;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="260" y="230" as="sourcePoint"/><mxPoint x="420" y="230" as="targetPoint"/></mxGeometry></mxCell><mxCell id="SD1b-M-2.1.1" value="2.1.1: // provideCheckingScope" style="endArrow=block;endFill=1;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="420" y="270" as="sourcePoint"/><mxPoint x="580" y="270" as="targetPoint"/></mxGeometry></mxCell><mxCell id="SD1b-M-2.1.1-R" value="2.1.1 (trả về): cụm rạp và suất chiếu đang soát" style="endArrow=open;dashed=1;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="580" y="310" as="sourcePoint"/><mxPoint x="420" y="310" as="targetPoint"/></mxGeometry></mxCell><mxCell id="SD1b-M-2.1.2" value="2.1.2: // rejectTicket (lý do: mã QR không tương ứng vé)" style="endArrow=block;endFill=1;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="420" y="380" as="sourcePoint"/><mxPoint x="260" y="380" as="targetPoint"/></mxGeometry></mxCell><mxCell id="SD1b-M-2.1.3" value="2.1.3: // admitTicket (cụm rạp và suất chiếu đang soát)" style="endArrow=block;endFill=1;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="420" y="450" as="sourcePoint"/><mxPoint x="900" y="450" as="targetPoint"/></mxGeometry></mxCell><mxCell id="SD1b-M-2.1.3.1" value="2.1.3.1: // checkBelongsToCinema (cụm rạp)" style="endArrow=block;endFill=1;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="900" y="540" as="sourcePoint"/><mxPoint x="740" y="540" as="targetPoint"/></mxGeometry></mxCell><mxCell id="SD1b-M-2.1.3.2" value="2.1.3.2: // markUsed" style="endArrow=block;endFill=1;html=1;align=left;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="900" y="610" as="sourcePoint"/><mxPoint x="900" y="630" as="targetPoint"/><Array as="points"><mxPoint x="940" y="610"/><mxPoint x="940" y="630"/></Array></mxGeometry></mxCell><mxCell id="SD1b-M-2.1.3-R" value="2.1.3 (trả về): kết quả soát: hợp lệ, hoặc một lý do duy nhất" style="endArrow=open;dashed=1;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="900" y="660" as="sourcePoint"/><mxPoint x="420" y="660" as="targetPoint"/></mxGeometry></mxCell><mxCell id="SD1b-M-2.1.4" value="2.1.4: // provideTicketContent" style="endArrow=block;endFill=1;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="420" y="730" as="sourcePoint"/><mxPoint x="900" y="730" as="targetPoint"/></mxGeometry></mxCell><mxCell id="SD1b-M-2.1.4.1" value="2.1.4.1: // provideShowtimeInfo" style="endArrow=block;endFill=1;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="900" y="770" as="sourcePoint"/><mxPoint x="740" y="770" as="targetPoint"/></mxGeometry></mxCell><mxCell id="SD1b-M-2.1.4.2" value="2.1.4.2: // provideBookingCode" style="endArrow=block;endFill=1;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="900" y="810" as="sourcePoint"/><mxPoint x="1060" y="810" as="targetPoint"/></mxGeometry></mxCell><mxCell id="SD1b-M-2.1.4-R" value="2.1.4 (trả về): nội dung vé" style="endArrow=open;dashed=1;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="900" y="850" as="sourcePoint"/><mxPoint x="420" y="850" as="targetPoint"/></mxGeometry></mxCell><mxCell id="SD1b-M-2.1.5" value="2.1.5: // showValidTicket (nội dung vé)" style="endArrow=block;endFill=1;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="420" y="890" as="sourcePoint"/><mxPoint x="260" y="890" as="targetPoint"/></mxGeometry></mxCell><mxCell id="SD1b-M-2.1.6" value="2.1.6: // rejectTicket (lý do: vé thuộc cụm rạp