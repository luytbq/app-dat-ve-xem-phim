          <mxCell id="CM2-O-RR" value="&lt;u&gt;:RefundRequest&lt;/u&gt;&lt;br&gt;«entity»" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="820" y="228.5" width="160" height="63" as="geometry" /></mxCell>
          <mxCell id="CM2-L1" value="1.1e: // logUnrecognizedTransaction (mã giao dịch, kết quả, mã tham chiếu lần giữ ghế, số tiền đã thanh toán, thời điểm nhận báo) (--&gt;) [kết quả thành công và hệ thống không nhận ra giao dịch (2e, BR-38)]&lt;br&gt;1.1d: // logUnrecognizedTransaction (mã giao dịch, kết quả, mã tham chiếu lần giữ ghế, số tiền đã thanh toán, thời điểm nhận báo) (--&gt;) [kết quả thất bại và hệ thống không nhận ra giao dịch (2d, BR-39)]&lt;br&gt;1.1.3a: // after(BR-43) handleRefundNoResponse (--&gt;)&lt;br&gt;1.1.3b: // logRefundFailure (mã giao dịch, số tiền hoàn) (--&gt;) [không phản hồi trong 30 giây và đã hết lượt thử lại (4b, BR-41)]&lt;br&gt;1.1.5a.1: // stopWaitingForRefundResult (--&gt;)&lt;br&gt;1.1.5b.1: // logRefundFailure (mã giao dịch, số tiền hoàn) (--&gt;) [hoàn tiền thất bại và đã hết lượt thử lại (5b, BR-41)]" style="endArrow=none;html=1;labelBackgroundColor=#ffffff;fontSize=10;align=center;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="CM2-O-PC" target="CM2-O-PC"><mxGeometry relative="1" as="geometry" /></mxCell>
          <mxCell id="CM2-L2" value="1.1.1.1a: // recordDuplicateReport (thời điểm nhận báo) (--&gt;) [kết quả thành công và giao dịch đã được xử lý trước đó (2a, BR-37)]&lt;br&gt;1.1.1c.2: // recordFailedResult (thất bại, thời điểm nhận báo) (--&gt;) [kết quả thất bại và lần giữ ghế đã hết hạn hoặc đã bị khách huỷ (2c, BR-39)]&lt;br&gt;1.1.1d.2: // recordFailedResult (thất bại, thời điểm nhận báo) (--&gt;) [kết quả thất bại, giao dịch nhận ra, không thuộc 2c: đã có vé hoặc lần giữ ghế đã có báo thất bại (2d, BR-39)]&lt;br&gt;1.1.1.3.1[BR-40]: «create» // createPaymentTransaction (mã giao dịch, số tiền đã thanh toán trong báo) (--&gt;)&lt;br&gt;1.1.1.4[BR-40]: // markLatePayment (lý do hoàn) (--&gt;)" style="endArrow=none;html=1;labelBackgroundColor=#ffffff;fontSize=10;align=center;" edge="1" parent="1" source="CM2-O-SH" target="CM2-O-PT"><mxGeometry relative="1" as="geometry" x="0.3" /></mxCell>
          <mxCell id="CM2-L3" value="1.1.1c: // settlePaymentReport (lần giữ ghế tìm theo mã giao dịch hoặc mã tham chiếu lần giữ ghế, kết quả, số tiền đã thanh toán, thời điểm nhận báo) (--&gt;) [kết quả thất bại và lần giữ ghế đã hết hạn hoặc đã bị khách huỷ (2c, BR-39)]&lt;br&gt;1.1.1d: // settlePaymentReport (lần giữ ghế tìm theo mã giao dịch hoặc mã tham chiếu lần giữ ghế, kết quả, số tiền đã thanh toán, thời điểm nhận báo) (--&gt;) [kết quả thất bại, giao dịch nhận ra, không thuộc 2c: đã có vé hoặc lần giữ ghế đã có báo thất bại (2d, BR-39)]&lt;br&gt;1.1.1[BR-40]: // settlePaymentReport (lần giữ ghế tìm theo mã giao dịch hoặc mã tham chiếu lần giữ ghế, kết quả, số tiền đã thanh toán, thời điểm nhận báo) (--&gt;)" style="endArrow=none;html=1;labelBackgroundColor=#ffffff;fontSize=10;align=center;" edge="1" parent="1" source="CM2-O-PC" target="CM2-O-SH"><mxGeometry relative="1" as="geometry" /></mxCell>
          <mxCell id="CM2-L4" value="1.1.1c.1: // checkHoldStillActive (thời điểm nhận báo) (--&gt;) [kết quả thất bại và lần giữ ghế đã hết hạn hoặc đã bị khách huỷ (2c, BR-39)]&lt;br&gt;1.1.1d.1: // checkHoldStillActive (thời điểm nhận báo) (--&gt;) [kết quả thất bại, giao dịch nhận ra, không thuộc 2c: đã có vé hoặc lần giữ ghế đã có báo thất bại (2d, BR-39)]&lt;br&gt;1.1.1.2[BR-40]: // checkHoldStillActive (thời điểm nhận báo) (--&gt;)&lt;br&gt;1.1.1.3[BR-40]: // recordPaymentTransaction (mã giao dịch, số tiền đã thanh toán trong báo) (--&gt;)" style="endArrow=none;html=1;labelBackgroundColor=#ffffff;fontSize=10;align=center;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="CM2-O-SH" target="CM2-O-SH"><mxGeometry relative="1" as="geometry" /></mxCell>
          <mxCell id="CM2-L5" value="1.1.3a.1: // recordResult (không phản hồi) (--&gt;)&lt;br&gt;1.1.3a.2: // checkRetryRemaining (--&gt;)&lt;br&gt;1.1.5a.2: // recordResult (thất bại) (--&gt;)&lt;br&gt;1.1.5a.3: // checkRetryRemaining (--&gt;)" style="endArrow=none;html=1;labelBackgroundColor=#ffffff;fontSize=10;align=center;" edge="1" parent="1" source="CM2-O-PC" target="CM2-O-RR"><mxGeometry relative="1" as="geometry" /></mxCell>
