          <mxCell id="CM2-L1" value="1.1e: // logUnrecognizedTransaction (mã giao dịch, kết quả, mã tham chiếu lần giữ ghế, số tiền đã thanh toán, thời điểm nhận báo) (--&gt;) [2e: không nhận ra]&lt;br&gt;1.1d: // logUnrecognizedTransaction (mã giao dịch, kết quả, mã tham chiếu lần giữ ghế, số tiền đã thanh toán, thời điểm nhận báo) (--&gt;) [2d: không nhận ra]&lt;br&gt;1.1.3a: // after(BR-43) handleRefundNoResponse (--&gt;)&lt;br&gt;1.1.3b: // logRefundFailure (mã giao dịch, số tiền hoàn) (--&gt;) [4b: hết lượt]&lt;br&gt;2a.1.1: // stopWaitingForRefundResult (--&gt;)&lt;br&gt;2a.1.4b: // logRefundFailure (mã giao dịch, số tiền hoàn) (--&gt;) [5b: hết lượt]" style="endArrow=none;html=1;labelBackgroundColor=#ffffff;fontSize=10;align=center;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="CM2-O-C" target="CM2-O-C"><mxGeometry relative="1" as="geometry" /></mxCell>
          <mxCell id="CM2-L2" value="1.1.1.1a: // recordDuplicateReport (thời điểm nhận báo) (--&gt;) [2a: báo trùng]&lt;br&gt;1.1.1c.2: // recordLateFailedResult (thất bại, thời điểm nhận báo) (--&gt;) [2c: thất bại muộn]&lt;br&gt;1.1.1d.2: // recordLateFailedResult (thất bại, thời điểm nhận báo) (--&gt;) [2d: thất bại khác]&lt;br&gt;1.1.1.3[BR-40]: «create» // createLatePaymentTransaction (mã giao dịch, số tiền đã thanh toán trong báo, lý do hoàn) (--&gt;)" style="endArrow=none;html=1;labelBackgroundColor=#ffffff;fontSize=10;align=center;" edge="1" parent="1" source="CM2-O-SH" target="CM2-O-PT"><mxGeometry relative="1" as="geometry" x="0.7" /></mxCell>
