          <mxCell id="SD1-N1" value="Các message 1 đến 1.1.1 (trả về) là tiếp nhận và xử lý báo của control dùng chung, UC-005 là chủ (SD1b, SD10 của UC-005); trang này vẽ nhánh thanh toán trễ. Lần giữ ghế Đang giữ mà quá hạn đã được chuyển sang Hết hạn trước message 1.1.1.2 (SD10 của UC-005)." style="shape=note;whiteSpace=wrap;html=1;size=14;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="520" height="90" as="geometry" /></mxCell>
          <mxCell id="SD1-N2" value="Thao tác không chia cắt theo lần giữ ghế (BR-85, BR-86): các message 1.1.1.1 đến 1.1.1.3 xảy ra liền nhau, báo khác của cùng lần giữ ghế chờ đến lượt." style="shape=note;whiteSpace=wrap;html=1;size=14;" vertex="1" parent="1"><mxGeometry x="40" y="210" width="520" height="70" as="geometry" /></mxCell>
          <mxCell id="SD1-M-1" value="1: // reportTransactionResult (kết quả thành công, mã giao dịch, mã tham chiếu lần giữ ghế, số tiền đã thanh toán)" style="endArrow=block;endFill=1;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="100" y="320" as="sourcePoint" /><mxPoint x="260" y="320" as="targetPoint" /></mxGeometry></mxCell>
